   abstract = {This paper describes a pulse technique for evaluating mte coefficients and equilibrium constants and for characterizing non-specific adsorption on affinity packings. This technique is also a convenient method for screening affinity carriers and for optimizing adsorp-tion, wash and elution conditions. The analyses are illustrated with examples and data from columns packed with monoclonal antibodies immobilized on controlled-pore glass and from a hapten-Sepharosegel used for antibody purification. The design equations are used to compare column and batch adsorption.},
   author = {F H Arnold and H W Blanch and C R Wilke},
