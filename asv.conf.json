{
    "version": 1,
    "project": "reactormodels",
    "project_url": "https://github.com/tmweigand/ReactorModels",
    "repo": ".",
    "branches": ["main"],
    "environment_type": "virtualenv",
    "pythons": ["3.11"],
    "benchmark_dir": "benchmarks",
    "env_dir": ".asv/env",
    "results_dir": ".asv/results",
    "html_dir": ".asv/html",
    "build_command": [
        "python -m pip wheel --no-deps --no-build-isolation -w {build_cache_dir} {build_dir}"
    ],
    "install_command": [
        "python -m pip install --no-cache-dir --no-binary scikits-odes-sundials {wheel_file}"
    ]
}